# DEVELOPMENT ONLY. Copy to root .env for API local commands. Never upload this file to hosting.
# Production/staging platform variable tables: docs/production-deployment.md
DATABASE_URL=postgresql://nestwise:CHANGE_ME_LOCAL@localhost:5432/nestwise
DATABASE_SSL_MODE=disable
DATABASE_PRIVATE_NETWORK=false
DATABASE_POOL_MAX=10
# Optional PEM CA for verify-full connections. Leave empty to use trusted system CAs.
DATABASE_CA_CERT=
PORT=3001
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:8081
NODE_ENV=development
# Set these in apps/app/.env or the build shell (Expo does not read the root .env).
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# Deployment preflight accepts staging or production only; not needed for local builds.
DEPLOY_ENV=development
# API only. disabled is honest unavailability; resend requires the next three values.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
APP_WEB_URL=
# Tests only: use a separate local database. Never run E2E against production.
TEST_DATABASE_URL=postgresql://nestwise:CHANGE_ME_LOCAL@localhost:5432/nestwise_test
